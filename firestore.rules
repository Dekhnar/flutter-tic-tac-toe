rules_version = '2';

// Players sign in anonymously: request.auth.uid is the player id stored in the game.
// Each kind of write the app makes has its own rule, with the exact fields it may change, and a move is checked against
// the board: exactly one empty cell takes the player's mark, the round ends only on a real line or a full board, and
// only the winner scores. The field names are those of `GameField` (lib/features/game/board/data/dto/game_document.dart).
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      // The game id is the code players share: anyone holding it may read the game, nobody may list games.
      allow get: if signedIn();
      allow list: if false;

      allow create: if isCreatedByHost();
      allow update: if isJoin() || isStart() || isMove() || isNewRound();
      allow delete: if false;

      function signedIn() {
        return request.auth != null;
      }

      function before() {
        return resource.data;
      }

      function after() {
        return request.resource.data;
      }

      function changedKeys() {
        return after().diff(before()).affectedKeys();
      }

      function isPlayer() {
        return request.auth.uid == before().fromId || request.auth.uid == before().toId;
      }

      function isValidName(name) {
        return name is string && name.size() > 0 && name.size() <= 20;
      }

      // The cells, row by row: 'X', 'O', or '' when empty.
      function emptyBoard() {
        return ['', '', '', '', '', '', '', '', ''];
      }

      // A TTL policy deletes the game at `expiresAt` (see README): the app sets it 30 days ahead, a day of clock skew
      // allowed.
      function isCreatedByHost() {
        let game = request.resource.data;
        return signedIn()
          && game.keys().hasOnly([
            'board', 'createdAt', 'currentPlayerId', 'currentRoundIndex', 'currentWinnerId', 'expiresAt', 'fromId',
            'fromName', 'fromWinCount', 'status', 'toId', 'toName', 'toWinCount', 'updatedAt'
          ])
          && game.createdAt == request.time
          && game.updatedAt == request.time
          && game.expiresAt is timestamp
          && game.expiresAt > request.time
          && game.expiresAt <= request.time + duration.value(31, 'd')
          && game.fromId == request.auth.uid
          && isValidName(game.fromName)
          && game.toId == null
          && game.toName == null
          && game.status == 'setup'
          && game.currentPlayerId == game.fromId
          && game.currentRoundIndex == 0
          && game.currentWinnerId == null
          && game.fromWinCount == 0
          && game.toWinCount == 0
          && game.board == emptyBoard();
      }

      function isJoin() {
        return signedIn()
          && before().toId == null
          && request.auth.uid != before().fromId
          && after().toId == request.auth.uid
          && isValidName(after().toName)
          && changedKeys().hasOnly(['toId', 'toName', 'updatedAt']);
      }

      function isStart() {
        return signedIn()
          && isPlayer()
          && before().status == 'setup'
          && before().toId != null
          && after().status == 'playing'
          && changedKeys().hasOnly(['status', 'updatedAt']);
      }

      function isMove() {
        let mark = before().currentPlayerId == before().fromId ? 'X' : 'O';
        return signedIn()
          && before().status == 'playing'
          && request.auth.uid == before().currentPlayerId
          && changedKeys().hasOnly([
            'board', 'currentPlayerId', 'currentWinnerId', 'fromWinCount', 'lastPlayAt', 'status', 'toWinCount',
            'updatedAt'
          ])
          && isOneEmptyCellMarked(before().board, after().board, mark)
          && isOutcomeOf(after().board, mark);
      }

      // Exactly one cell differs, and it went from empty to [mark]: one more [mark], one less empty cell.
      function isOneEmptyCellMarked(b, a, mark) {
        return a.size() == 9
          && [
            a[0] == b[0], a[1] == b[1], a[2] == b[2], a[3] == b[3], a[4] == b[4], a[5] == b[5], a[6] == b[6],
            a[7] == b[7], a[8] == b[8]
          ].removeAll([true]).size() == 1
          && countOf(a, mark) == countOf(b, mark) + 1
          && countOf(a, '') == countOf(b, '') - 1;
      }

      function countOf(cells, value) {
        return cells.size() - cells.removeAll([value]).size();
      }

      function hasLine(c, m) {
        return (c[0] == m && c[1] == m && c[2] == m) || (c[3] == m && c[4] == m && c[5] == m)
          || (c[6] == m && c[7] == m && c[8] == m) || (c[0] == m && c[3] == m && c[6] == m)
          || (c[1] == m && c[4] == m && c[7] == m) || (c[2] == m && c[5] == m && c[8] == m)
          || (c[0] == m && c[4] == m && c[8] == m) || (c[2] == m && c[4] == m && c[6] == m);
      }

      function isOutcomeOf(board, mark) {
        let mover = before().currentPlayerId;
        let opponent = mover == before().fromId ? before().toId : before().fromId;
        let won = hasLine(board, mark);
        let full = !board.hasAny(['']);
        return (won
            && after().status == 'finished' && after().currentPlayerId == mover
            && after().currentWinnerId == mover && scoresWonBy(mover))
          || (!won && full
            && after().status == 'finished' && after().currentPlayerId == mover
            && after().currentWinnerId == null && scoresUnchanged())
          || (!won && !full
            && after().status == 'playing' && after().currentPlayerId == opponent
            && after().currentWinnerId == null && scoresUnchanged());
      }

      function scoresUnchanged() {
        return after().fromWinCount == before().fromWinCount && after().toWinCount == before().toWinCount;
      }

      function scoresWonBy(winner) {
        return winner == before().fromId
          ? after().fromWinCount == before().fromWinCount + 1 && after().toWinCount == before().toWinCount
          : after().toWinCount == before().toWinCount + 1 && after().fromWinCount == before().fromWinCount;
      }

      function isNewRound() {
        let nextRound = before().currentRoundIndex + 1;
        return signedIn()
          && isPlayer()
          && before().status == 'finished'
          && after().status == 'playing'
          && after().currentRoundIndex == nextRound
          && after().currentPlayerId == (nextRound % 2 == 0 ? before().fromId : before().toId)
          && after().currentWinnerId == null
          && after().board == emptyBoard()
          && scoresUnchanged()
          && changedKeys().hasOnly([
            'board', 'currentPlayerId', 'currentRoundIndex', 'currentWinnerId', 'lastPlayAt', 'status', 'updatedAt'
          ]);
      }
    }
  }
}
